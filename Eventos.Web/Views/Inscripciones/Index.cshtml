@model List<Inscripcion>
@{ViewData["Title"] = "Inscripciones";}
<section class="page-heading"><div><p class="eyebrow">CADA LUGAR CUENTA</p><h1>Conexiones confirmadas<span>.</span></h1><p class="lead">Consulta las reservas y administra los cupos de cada evento.</p></div><a asp-action="Create" class="btn btn-primary">＋ Nueva inscripción</a></section>
<section class="stats"><div><strong>@Model.Count(i => i.Estado == "Confirmada")</strong><span>confirmadas</span></div><div><strong>@Model.Count(i => i.Estado == "Cancelada")</strong><span>canceladas</span></div><div><strong>@Model.Count</strong><span>registros en el historial</span></div></section>
<section class="table-panel"><div class="table-heading"><h2>Historial de inscripciones</h2><span class="muted">Más recientes primero</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Evento</th><th>Asistente</th><th>Fecha de inscripción</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var i in Model){<tr><td><strong>@i.Evento?.Titulo</strong><small class="table-sub">@i.Evento?.Fecha.ToString("dd MMM yyyy · HH:mm")</small></td><td>@i.Asistente?.Nombres<small class="table-sub">DNI @i.Asistente?.Dni</small></td><td>@i.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td><td><span class="status @(i.Estado == "Confirmada" ? "confirmed" : "cancelled")">@i.Estado</span></td><td>@if(i.Estado == "Confirmada"){<a class="danger-link" asp-action="Cancelar" asp-route-id="@i.Id">Cancelar</a>}else{<span class="muted">—</span>}</td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state"><h2>El primer encuentro está cerca</h2><p>Inscribe a un asistente para comenzar el historial.</p><a class="btn btn-primary" asp-action="Create">Nueva inscripción</a></div>}</section>
