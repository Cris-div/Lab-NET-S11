@model Inscripcion
@{ViewData["Title"] = "Nueva inscripción";}
<a class="back-link" asp-action="Index">← Volver a inscripciones</a><div class="form-heading"><p class="eyebrow">RESERVA UN LUGAR</p><h1>Nos vemos en el evento<span>.</span></h1><p class="muted">Elige el encuentro y la persona que participará.</p></div><form asp-action="Create" method="post" class="form-panel"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div class="form-field"><label asp-for="EventoId"></label><select asp-for="EventoId" asp-items="ViewBag.Eventos" class="form-select"><option value="">Selecciona un evento</option></select><span asp-validation-for="EventoId" class="text-danger"></span></div><div class="form-field"><label asp-for="AsistenteId"></label><select asp-for="AsistenteId" asp-items="ViewBag.Asistentes" class="form-select"><option value="">Selecciona un asistente</option></select><span asp-validation-for="AsistenteId" class="text-danger"></span></div><p class="form-help">La inscripción se confirma si el evento tiene cupos, aún no comienza y el asistente no está inscrito.</p><div class="form-actions"><button type="submit" class="btn btn-primary">Confirmar inscripción</button><a asp-action="Index" class="btn btn-light">Volver</a></div></form>
@section Scripts {<partial name="_ValidationScriptsPartial"/>}
