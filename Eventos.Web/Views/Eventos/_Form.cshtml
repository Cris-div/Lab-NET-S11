@model Evento
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="form-field"><label asp-for="Titulo"></label><input asp-for="Titulo" class="form-control" maxlength="100" placeholder="Nombre del evento"/><span asp-validation-for="Titulo" class="text-danger"></span></div>
<div class="form-row"><div class="form-field"><label asp-for="CategoriaId"></label><select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select"><option value="">Selecciona una categoría</option></select><span asp-validation-for="CategoriaId" class="text-danger"></span></div><div class="form-field"><label asp-for="Modalidad"></label><select asp-for="Modalidad" class="form-select"><option value="Presencial">Presencial</option><option value="Virtual">Virtual</option></select><span asp-validation-for="Modalidad" class="text-danger"></span></div></div>
<div class="form-row"><div class="form-field"><label asp-for="Fecha"></label><input asp-for="Fecha" type="datetime-local" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}"/><span asp-validation-for="Fecha" class="text-danger"></span></div><div class="form-field"><label asp-for="Lugar"></label><input asp-for="Lugar" class="form-control" maxlength="100" placeholder="Dirección, sala o enlace"/><span asp-validation-for="Lugar" class="text-danger"></span></div></div>
<div class="form-row"><div class="form-field"><label asp-for="Aforo"></label><input asp-for="Aforo" type="number" min="1" max="5000" class="form-control"/><span asp-validation-for="Aforo" class="text-danger"></span></div><div class="form-field"><label asp-for="Precio">Precio por persona (S/)</label><input asp-for="Precio" type="number" step="0.01" min="0" max="99999999.99" class="form-control"/><span asp-validation-for="Precio" class="text-danger"></span><small class="muted">Usa 0 para un evento gratuito.</small></div></div>
