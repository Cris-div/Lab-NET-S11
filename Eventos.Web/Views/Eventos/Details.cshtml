@model Eventos.Web.ViewModels.EventoFila
@{ ViewData["Title"] = "Detalle del evento"; var e = Model.Evento; }
<a class="back-link" asp-action="Index">← Volver a la agenda</a><section class="detail-panel"><p class="eyebrow">@e.Categoria?.Nombre · @e.Modalidad</p><h1>@e.Titulo<span>.</span></h1><p class="lead">@e.Fecha.ToString("dddd dd 'de' MMMM 'de' yyyy · HH:mm") h</p><dl class="detail-grid"><div><dt>Lugar</dt><dd>@e.Lugar</dd></div><div><dt>Precio</dt><dd>@(e.Precio == 0 ? "Gratis" : "S/ " + e.Precio.ToString("N2"))</dd></div><div><dt>Aforo total</dt><dd>@e.Aforo personas</dd></div><div><dt>Confirmados</dt><dd>@Model.Confirmados asistentes</dd></div><div><dt>Cupos disponibles</dt><dd>@Model.Disponibles</dd></div><div><dt>Modalidad</dt><dd>@e.Modalidad</dd></div></dl><div class="form-actions"><a class="btn btn-primary" asp-controller="Inscripciones" asp-action="Create" asp-route-eventoId="@e.Id">Inscribir asistente ↗</a><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">Editar evento</a><a class="danger-link" asp-action="Delete" asp-route-id="@e.Id">Desactivar</a></div></section>
