@model List<Asistente>
@{ViewData["Title"] = "Asistentes";}
<section class="page-heading"><div><p class="eyebrow">PERSONAS QUE CONECTAN</p><h1>La comunidad crece<span>.</span></h1><p class="lead">Gestiona a quienes hacen posible cada encuentro.</p></div><a asp-action="Create" class="btn btn-primary">＋ Registrar asistente</a></section>
<section class="table-panel"><div class="table-heading"><h2>Directorio de asistentes</h2><span class="pill">@Model.Count activos</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Nombres</th><th>DNI</th><th>Correo</th><th>Teléfono</th><th>Estado</th></tr></thead><tbody>@foreach(var a in Model){<tr><td><span class="avatar">@a.Nombres.Substring(0,1)</span><strong>@a.Nombres</strong></td><td>@a.Dni</td><td>@a.Correo</td><td>@(a.Telefono ?? "Sin registrar")</td><td><span class="status confirmed">Activo</span></td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="empty-state">Todavía no hay asistentes. Registra el primero para comenzar.</p>}</section>
