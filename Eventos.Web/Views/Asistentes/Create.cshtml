@model Asistente
@{ViewData["Title"] = "Registrar asistente";}
<a class="back-link" asp-action="Index">← Volver a asistentes</a><div class="form-heading"><p class="eyebrow">SUMA UNA NUEVA PERSONA</p><h1>Un nuevo asistente<span>.</span></h1><p class="muted">El DNI y el correo identifican a cada persona de forma única.</p></div><form asp-action="Create" method="post" class="form-panel"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div class="form-field"><label asp-for="Nombres"></label><input asp-for="Nombres" class="form-control" maxlength="100" placeholder="Nombres y apellidos"/><span asp-validation-for="Nombres" class="text-danger"></span></div><div class="form-row"><div class="form-field"><label asp-for="Dni"></label><input asp-for="Dni" class="form-control" maxlength="8" inputmode="numeric" placeholder="8 dígitos"/><span asp-validation-for="Dni" class="text-danger"></span></div><div class="form-field"><label asp-for="Telefono">Teléfono (opcional)</label><input asp-for="Telefono" class="form-control" maxlength="9" placeholder="Hasta 9 caracteres"/><span asp-validation-for="Telefono" class="text-danger"></span></div></div><div class="form-field"><label asp-for="Correo"></label><input asp-for="Correo" type="email" class="form-control" maxlength="254" placeholder="nombre@correo.com"/><span asp-validation-for="Correo" class="text-danger"></span></div><div class="form-actions"><button type="submit" class="btn btn-primary">Registrar asistente</button><a asp-action="Index" class="btn btn-light">Volver</a></div></form>
@section Scripts {<partial name="_ValidationScriptsPartial"/>}
